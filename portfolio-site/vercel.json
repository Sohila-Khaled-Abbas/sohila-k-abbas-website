{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "functions": {
    "api/business-inquiry.mjs": {
      "maxDuration": 10,
      "includeFiles": "server/business-approvals.json"
    },
    "api/lead.mjs": {
      "maxDuration": 10,
      "includeFiles": "server/business-approvals.json"
    }
  },
  "redirects": [
    {
      "source": "/learning",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/learning/:path*",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/learn",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/learn/:path*",
      "destination": "/work/",
      "permanent": true
    },
    {
